UI {
    // =========================================================================
    // VibeFramework - Production Demo Application
    // =========================================================================
    // This .vibe file demonstrates all 20+ widget types with full functionality
    
    // =========================================================================
    // SECTION 1: HEADER
    // =========================================================================
    Label("🚀 VibeFramework Demo", font_size=28, bold=true)
    Label("Build Cross-Platform Apps with Single .vibe File", font_size=14)
    
    // =========================================================================
    // SECTION 2: BASIC WIDGETS
    // =========================================================================
    Label("━━━━━━━━━━━━━━━━ Basic Widgets ━━━━━━━━━━━━━━━━", font_size=16)
    
    // Buttons with variants
    Label("Button Variants:", bold=true)
    Button("Primary Button", variant="primary")
    Button("Success Button", variant="success")
    Button("Danger Button", variant="danger")
    Button("Warning Button", variant="warning")
    Button("Outline Button", variant="outline")
    
    // Text Fields
    Label("Text Input Fields:", bold=true)
    TextField(hint="Enter your full name...")
    TextField(hint="Email address")
    TextField(hint="Password", password=true)
    TextField(hint="Phone number")
    TextField(hint="Enter description...", multiline=true)
    
    // Labels
    Label("Labels:", bold=true)
    Label("This is a standard label", font_size=14)
    Label("Bold heading text", font_size=18, bold=true)
    Label("Secondary information", font_size=12)
    
    // =========================================================================
    // SECTION 3: SELECTION WIDGETS
    // =========================================================================
    Label("━━━━━━━━━━━━━━━━ Selection Widgets ━━━━━━━━━━━━━━━━", font_size=16)
    
    // Checkboxes
    Label("Checkboxes:", bold=true)
    Checkbox(label="I agree to Terms & Conditions")
    Checkbox(label="Subscribe to newsletter")
    Checkbox(label="Remember me")
    Checkbox(label="Enable notifications")
    
    // Switch
    Label("Switch (Toggle):", bold=true)
    Switch(active=false)
    Label("Dark Mode")
    Switch(active=true)
    Label("Auto-save")
    
    // Radio Buttons
    Label("Radio Buttons (Mutually Exclusive):", bold=true)
    Radio(options="Small;Medium;Large;Extra Large", selected="Medium")
    
    // Slider
    Label("Volume Slider:", bold=true)
    Slider(min=0, max=100, value=75)
    
    // =========================================================================
    // SECTION 4: PROGRESS & SELECTION
    // =========================================================================
    Label("━━━━━━━━━━━━━━━━ Progress & Selection ━━━━━━━━━━━━━━━━", font_size=16)
    
    // Progress Bar
    Label("Progress Indicators:", bold=true)
    ProgressBar(value=70, max=100)
    
    // Spinner/Dropdown
    Label("Dropdown/Spinner:", bold=true)
    Spinner(options="Select an option;Option A;Option B;Option C;Option D", text="Select an option")
    
    // =========================================================================
    // SECTION 5: LISTS & GRIDS
    // =========================================================================
    Label("━━━━━━━━━━━━━━━━ Lists & Grids ━━━━━━━━━━━━━━━━", font_size=16)
    
    // List View
    Label("List View:", bold=true)
    List(items="Dashboard;Profile;Settings;Notifications;Help;Logout")
    
    // Grid View
    Label("Grid View:", bold=true)
    Grid(items="Product 1;Product 2;Product 3;Product 4", cols=2)
    
    // =========================================================================
    // SECTION 6: SEARCH & NAVIGATION
    // =========================================================================
    Label("━━━━━━━━━━━━━━━━ Search & Navigation ━━━━━━━━━━━━━━━━", font_size=16)
    
    // Search Bar
    Label("Search Bar:", bold=true)
    SearchBar(placeholder="Search products, categories...")
    
    // =========================================================================
    // SECTION 7: FORM
    // =========================================================================
    Label("━━━━━━━━━━━━━━━━ Form Components ━━━━━━━━━━━━━━━━", font_size=16)
    
    // Complete Form
    Label("Registration Form:", bold=true)
    Form(fields="text:Full Name:Enter your full name;email:Email:Enter email address;password:Password:Create password;number:Phone:Enter phone number")
    
    // =========================================================================
    // SECTION 8: CARDS & CONTAINERS
    // =========================================================================
    Label("━━━━━━━━━━━━━━━━ Cards & Containers ━━━━━━━━━━━━━━━━", font_size=16)
    
    // Card
    Card(title="🎉 Welcome to VibeFramework", content="Build beautiful cross-platform applications using a single .vibe file! Features include 20+ widget types, multiple layouts, event handling, state management, and theming.")
    
    Card(title="📱 Cross-Platform", content="Deploy to Android, iOS, Windows, macOS, and Linux from a single codebase.")
    
    // =========================================================================
    // SECTION 9: DATE & TIME
    // =========================================================================
    Label("━━━━━━━━━━━━━━━━ Date & Time Pickers ━━━━━━━━━━━━━━━━", font_size=16)
    
    // Calendar
    Label("Calendar/Date Picker:", bold=true)
    Calendar()
    
    // Time Picker
    Label("Time Picker:", bold=true)
    TimePicker()
    
    // =========================================================================
    // SECTION 10: ADVANCED (Uncomment to enable)
    // =========================================================================
    // Tabs and Accordion require more complex setup
    // For production use, see the full documentation
}

STYLE {
    // Theme: dark, light, ocean, sunset
    theme: ocean
    
    // Custom widget styles
    style primary_button {
        background_color: #3498db
        border_radius: 8
    }
    
    style card_style {
        background: #ffffff
        border_radius: 12
        elevation: 4
    }
}

BACKEND {
    // =========================================================================
    // VibeFramework Backend Logic
    // =========================================================================
    
    // Import required modules
    import datetime
    
    // =========================================================================
    // STATE MANAGEMENT
    // =========================================================================
    
    // Create reactive state variables
    user_name = State.create_state("user_name", "Developer")
    user_email = State.create_state("user_email", "")
    is_premium = State.create_state("is_premium", false)
    selected_category = State.create_state("selected_category", "All")
    search_query = State.create_state("search_query", "")
    
    // =========================================================================
    // EVENT HANDLERS
    // =========================================================================
    
    // Button click handler
    def on_button_click(widget):
        print("✅ Button clicked!")
        App.show_toast("Button clicked successfully!", 2.0)
    
    // Form submission handler
    def on_form_submit(data):
        print(f"📝 Form submitted with data: {data}")
        
        # Extract form data
        name = data.get("Full Name", "")
        email = data.get("Email", "")
        
        # Update state
        if name:
            State.set_state("user_name", name)
        if email:
            State.set_state("user_email", email)
        
        # Show confirmation
        App.show_toast(f"Welcome, {name}! 🎉", 3.0)
        
        # Show dialog
        App.show_dialog(
            title="Registration Successful!",
            content=f"Thank you for registering, {name}!\n\nEmail: {email}\n\nWelcome to VibeFramework!",
            actions=[("Great!", lambda x: x.dismiss())]
        )
    
    // List item click handler
    def on_list_item_click(index, item):
        print(f"📋 List item clicked: [{index}] {item}")
        State.set_state("selected_category", item)
        App.show_toast(f"Selected: {item}", 1.5)
    
    // Search handler
    def on_search(query):
        print(f"🔍 Searching for: {query}")
        State.set_state("search_query", query)
        
        if len(query) > 2:
            App.show_toast(f"Found results for: {query}", 2.0)
    
    // Date selection handler
    def on_date_select(date_obj):
        print(f"📅 Date selected: {date_obj}")
        formatted_date = date_obj.strftime("%B %d, %Y")
        App.show_toast(f"Date: {formatted_date}", 2.0)
    
    // Time selection handler
    def on_time_select(time_obj):
        print(f"⏰ Time selected: {time_obj}")
        formatted_time = time_obj.strftime("%H:%M")
        App.show_toast(f"Time: {formatted_time}", 2.0)
    
    // Slider value change handler
    def on_slider_change(value):
        print(f"📊 Slider value: {value}")
        volume_percent = int(value)
        # Update volume state
        State.set_state("volume", volume_percent)
    
    // Switch toggle handler
    def on_switch_toggle(active):
        print(f"🔄 Switch toggled: {active}")
        State.set_state("is_premium", active)
        if active:
            App.show_toast("Premium mode enabled! 🌟", 2.0)
    
    // Checkbox handler
    def on_checkbox_change(active):
        print(f"☑️ Checkbox changed: {active}")
    
    // Radio button handler
    def on_radio_select(option):
        print(f"⚪ Radio selected: {option}")
        App.show_toast(f"Size: {option}", 1.5)
    
    // =========================================================================
    // INITIALIZATION
    // =========================================================================
    
    print("=" * 60)
    print("🚀 VibeFramework Application Started")
    print("=" * 60)
    print(f"👤 User: {State.get_state('user_name')}")
    print(f"📧 Email: {State.get_state('user_email') or 'Not set'}")
    print(f"⭐ Premium: {State.get_state('is_premium')}")
    print(f"📅 Time: {datetime.datetime.now().strftime('%Y-%m-%d %H:%M:%S')}")
    print("=" * 60)
    
    // Initialize default values
    def initialize_app():
        print("🔧 Initializing application...")
        State.set_state("app_initialized", true)
        State.set_state("last_updated", datetime.datetime.now().isoformat())
    
    // Run initialization
    initialize_app()
    
    // =========================================================================
    // CUSTOM FUNCTIONS
    // =========================================================================
    
    // Helper function to validate email
    def validate_email(email):
        import re
        pattern = r'^[\w\.-]+@[\w\.-]+\.\w+$'
        return re.match(pattern, email) is not None
    
    // Helper function to format currency
    def format_currency(amount):
        return f"${amount:,.2f}"
    
    // Helper to show loading
    def show_loading():
        App.show_toast("Loading...", 1.0)
    
    // =========================================================================
    // END OF BACKEND
    // =========================================================================
}
